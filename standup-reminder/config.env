# Stand Up Reminder configuration
# Edit these values, then re-run ./install.sh if you change schedule hours
# (install regenerates the launchd calendar intervals).

# Work window: reminders fire while hour is in [START_HOUR, END_HOUR)
# Example: 9 and 17 → 9:00am through 4:30pm (not after 5:00pm)
START_HOUR=9
END_HOUR=17

# Interval in minutes (must divide 60 evenly: 15, 20, 30, or 60)
INTERVAL_MINUTES=30

# 1 = Monday–Friday only; 0 = every day including weekends
WEEKDAYS_ONLY=1

# 1 = do not notify when the Mac is locked / at the login screen
SKIP_WHEN_LOCKED=1

NOTIFICATION_TITLE="Stand Up Reminder"
NOTIFICATION_BODY="Time to stand up and move around for a minute or two."

# macOS alert sound names: Glass, Ping, Pop, Purr, Sosumi, Submarine, Blow, Bottle, Frog, Funk, Hero, Morse, Tink
SOUND_NAME="Glass"
